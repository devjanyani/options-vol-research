# Copy this file to .env and fill in what you need. Everything is optional.

# Enables optional AI-written explanations on the Anomaly Scanner page.
# Without it, the app shows rule-based explanations only.
ANTHROPIC_API_KEY=

# Model used for explanations (a small, inexpensive model is plenty).
OVRP_LLM_MODEL=claude-haiku-5-5

# Where the SQLite database lives (default: data_store/options_research.db)
# OVRP_DB_PATH=data_store/options_research.db

# Developer UI test mode ONLY. Renders the UI from synthetic numbers with a red
# "SYNTHETIC TEST DATA" banner. Never use this for analysis or screenshots.
# OVRP_PROVIDER=synthetic
